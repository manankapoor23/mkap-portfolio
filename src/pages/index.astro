---
const profile = {
  name: "Manan Kapoor",
  lede: "I work on the inside of language models — paged KV-caches that make inference cheaper, and instruction datasets that teach models new languages.",
  location: "Chandigarh, India",
  email: "23.kapoormanan@gmail.com",
  links: [
    { label: "GitHub", href: "https://github.com/manankapoor23" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/manan-kapoor-8545002a0/" },
    { label: "LeetCode", href: "https://leetcode.com/u/manankapoor23" },
    { label: "Résumé", href: "/resume.pdf" },
  ],
};

const experience = [
  {
