---
import Base from "../layouts/Base.astro";
import { profile, about, experience, featured, skills } from "../data/site.ts";

// --- Build-time GitHub enrichment: real stars + public repo count ---
let stars: Record<string, number> = {};
let repoCount: number | null = null;
try {
  const res = await fetch(
    `https://api.github.com/users/${profile.githubUser}/repos?per_page=100&sort=pushed`,
    { headers: { Accept: "application/vnd.github+json" } }
  );
  if (res.ok) {
    const repos = await res.json();
    repoCount = Array.isArray(repos) ? repos.filter((r: any) => !r.fork).length : null;
    for (const r of repos) stars[r.name] = r.stargazers_count ?? 0;
  }
} catch (e) {
  // offline build — cards still render, just without live stars
}

const projects = featured.map((p) => ({
  ...p,
  stars: p.repo ? stars[p.repo] ?? null : null,
}));
---

<Base>
  <nav class="top">
    <div class="wrap inner">
      <a href="#top" class="brand">MK</a>
      <div class="links">
        <a href="#about">About</a>
        <a href="#work">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#stack">Stack</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header id="top" class="hero">
    <span class="ghost" aria-hidden="true">MANAN&nbsp;&nbsp;MANAN&nbsp;&nbsp;MANAN&nbsp;&nbsp;</span>
    <div class="wrap hero-inner">
      <p class="eyebrow mono">{profile.role}</p>
      <h1>{profile.name}</h1>
      <p class="lede">{profile.tagline}</p>
      <div class="cta">
        <a class="btn primary" href="#projects">View projects</a>
        <a class="btn" href={profile.resume} target="_blank" rel="noopener">Résumé</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub{repoCount ? ` · ${repoCount} repos` : ""}</a>
      </div>
    </div>
  </header>

  <!-- ABOUT -->
  <section id="about" class="wrap reveal">
    <p class="label">About</p>
    <div class="about">
      {about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="work" class="wrap">
    <p class="label reveal">Experience</p>
    <div class="entries">
      {experience.map((e) => (
        <article class="entry reveal">
          <div class="entry-meta">
            <span class="period mono">{e.period}</span>
            <span class="place">{e.place}</span>
            <div class="chips">{e.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
          <div class="entry-body">
            <h3>{e.role} <span class="org">· {e.org}</span></h3>
            <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="wrap">
    <p class="label reveal">Projects</p>
    <h2 class="title reveal">Things I've built</h2>
    <div class="grid">
      {projects.map((p) => (
        <a class="card reveal" href={p.href} target="_blank" rel="noopener">
          <div class="card-top">
            <h3>{p.title}</h3>
            <span class="arrow">↗</span>
          </div>
          <p class="card-blurb">{p.blurb}</p>
          <div class="card-foot">
            <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
            {p.stars ? <span class="stars mono">★ {p.stars}</span> : null}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- STACK -->
  <section id="stack" class="wrap">
    <p class="label reveal">Stack</p>
    <dl class="stack reveal">
      {skills.map((s) => (
        <div class="stack-row">
          <dt>{s.group}</dt>
          <dd>{s.items.map((i) => <span class="pill">{i}</span>)}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- CONTACT -->
  <footer id="contact">
    <div class="wrap contact">
      <div>
        <h2 class="title" style="margin-bottom:0.6rem">Let's talk.</h2>
        <p style="color:var(--muted);margin:0 0 1.4rem;max-width:40ch">Open to 2026 AI/ML &amp; SWE internships and research. {profile.location}.</p>
        <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
      <div class="social mono">
        <a href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={profile.leetcode} target="_blank" rel="noopener">LeetCode ↗</a>
        <a href={profile.resume} target="_blank" rel="noopener">Résumé ↗</a>
      </div>
    </div>
  </footer>

  <style>
    /* HERO */
    .hero { position: relative; overflow: hidden; padding: clamp(6rem, 20vh, 12rem) 0 6rem; }
    .ghost {
      position: absolute; top: 8%; left: 0; margin: 0;
      font-size: clamp(8rem, 26vw, 20rem); font-weight: 800; letter-spacing: -0.06em;
      line-height: 1; color: var(--ink); opacity: 0.035; white-space: nowrap;
      pointer-events: none; user-select: none; z-index: 0;
      will-change: transform; animation: drift 30s linear infinite;
    }
    @keyframes drift { from { transform: translateX(0); } to { transform: translateX(-33.333%); } }
    @media (prefers-reduced-motion: reduce) { .ghost { animation: none; } }
    .hero-inner { position: relative; z-index: 1; }
    .eyebrow { font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin: 0 0 1.1rem; }
    h1 { font-size: clamp(3.2rem, 10vw, 6.4rem); font-weight: 700; line-height: 0.92; letter-spacing: -0.045em; margin: 0; }
    .lede { font-size: clamp(1.1rem, 2.3vw, 1.4rem); color: var(--muted); max-width: 40ch; margin: 1.6rem 0 2.2rem; }
    .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }
    .btn {
      display: inline-flex; align-items: center; padding: 0.62rem 1.15rem; border-radius: 999px;
      border: 1px solid var(--panel-brd); background: var(--panel); font-size: 0.9rem;
      color: var(--ink); transition: border-color .18s, background .18s, transform .18s;
    }
    .btn:hover { border-color: var(--accent); transform: translateY(-2px); }
    .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn.primary:hover { filter: brightness(1.08); }
    :root[data-theme="light"] .btn.primary { color: #fff; }

    .about { max-width: 60ch; }
    .about p { color: var(--muted); font-size: 1.05rem; margin: 0 0 1rem; }

    /* Experience */
    .entries { display: grid; gap: 0; }
    .entry { display: grid; grid-template-columns: 220px 1fr; gap: 2.4rem; padding: 2rem 0; border-top: 1px solid var(--line); }
    .entry:first-child { border-top: none; }
    .entry-meta { display: flex; flex-direction: column; gap: 0.5rem; }
    .period { font-size: 0.85rem; color: var(--ink); }
    .place { font-size: 0.85rem; color: var(--muted); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; }
    .chip { font-size: 0.7rem; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 0.12rem 0.45rem; }
    .entry-body h3 { font-size: 1.15rem; font-weight: 600; margin: 0 0 0.7rem; letter-spacing: -0.01em; }
    .entry-body .org { color: var(--muted); font-weight: 400; }
    .entry-body ul { margin: 0; padding-left: 1.05rem; }
    .entry-body li { color: var(--muted); margin-bottom: 0.5rem; }
    @media (max-width: 680px) { .entry { grid-template-columns: 1fr; gap: 1rem; } }

    /* Projects grid */
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .card {
      display: flex; flex-direction: column; padding: 1.5rem;
      background: var(--panel); border: 1px solid var(--panel-brd); border-radius: 16px;
      transition: transform .2s ease, border-color .2s ease, background .2s ease;
    }
    .card:hover { transform: translateY(-4px); border-color: var(--accent); background: var(--accent-soft); }
    .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .card h3 { font-size: 1.05rem; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
    .card .arrow { color: var(--muted); transition: color .18s, transform .18s; }
    .card:hover .arrow { color: var(--accent); transform: translate(2px, -2px); }
    .card-blurb { color: var(--muted); font-size: 0.92rem; margin: 0.7rem 0 1.1rem; flex: 1; }
    .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .tag { font-size: 0.72rem; color: var(--muted); }
    .tag:not(:last-child)::after { content: " ·"; }
    .stars { font-size: 0.78rem; color: var(--accent); white-space: nowrap; }
    @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }

    /* Stack */
    .stack { margin: 0; }
    .stack-row { display: grid; grid-template-columns: 160px 1fr; gap: 1.5rem; padding: 1rem 0; border-top: 1px solid var(--line); }
    .stack-row:first-child { border-top: none; }
    .stack dt { font-weight: 500; color: var(--ink); font-size: 0.92rem; }
    .stack dd { margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .pill { font-size: 0.82rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.7rem; }
    @media (max-width: 680px) { .stack-row { grid-template-columns: 1fr; gap: 0.6rem; } }

    /* Contact */
    .contact { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
    .social { display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.9rem; }
    .social a { color: var(--muted); transition: color .18s; }
    .social a:hover { color: var(--accent); }
  </style>
</Base>
