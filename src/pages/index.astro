    org: "Thapar Institute of Engineering & Technology",
    period: "2025 — Present",
    points: [
      "Built <b>PLC-Rewrite</b>, the first multi-task Punjabi instruction dataset for controlled text rewriting — 16.43M tokens from 600+ curated sources, with a Gemini 2.0 Flash teacher pipeline generating 91,000+ instruction-conditioned samples across 6 tasks.",
      "Structural validation dropped ~37% corrupt samples and reached 100% instruction-compliance (BERTScore ≥ 0.929 on every task).",
      "Fine-tuned LLaMA 3.1 8B with QLoRA (4-bit NF4, r=64, α=128, 167M trainable params); loss 0.55 → 0.34, yielding consistent Gurmukhi output where the base model fails entirely.",
    ],
  },
];

const education = {
  degree: "B.E. Computer Engineering",
  org: "Thapar Institute of Engineering & Technology",
  period: "2024 — 2028",
  note: "CGPA 8.07 · OS, DBMS, DSA, Machine Learning",
};

const projects = [
  {
    name: "KV-Paged-Attention",
    href: "https://github.com/manankapoor23/KV-Paged-Attention",
    tags: "Python · PyTorch · ML Systems",
    blurb: "A paged KV-cache for transformer inference — logical tokens decoupled from physical memory for 40%+ savings in long-context decoding, with page tables, reference counting, prefix reuse and copy-on-write.",
  },
  {
    name: "NL-SQL",
    href: "https://github.com/manankapoor23/NL-SQL",
    tags: "LangChain · LLMs · Slack",
    blurb: "A Slack data assistant that turns plain-English questions into schema-aware SQL, runs it against a live database, and returns results in-channel.",
  },
  {
    name: "makoto-watermark-LLM",
    href: "https://github.com/manankapoor23/makoto-watermark-LLM",
    tags: "Python · NLP",
    blurb: "From-scratch reproduction of NS-Watermark and Soft-Watermark for LLM text watermarking.",
  },
  {
    name: "Learn_ETL",
    href: "https://github.com/manankapoor23/Learn_ETL",
    tags: "Python · MLflow",
    blurb: "End-to-end ETL/ML pipeline for phishing-site detection — MongoDB ingestion, KNN imputation, MLflow tracking.",
  },
  {
    name: "Server-Load-Prediction",
    href: "https://github.com/manankapoor23/Server-Load-Prediction",
    tags: "XGBoost · FastAPI",
    blurb: "Forecasts datacenter server overload 10 minutes ahead, served through a FastAPI dashboard.",
  },
  {
    name: "claudget",
    href: "https://github.com/manankapoor23/claudget",
    tags: "TypeScript",
    blurb: "A live, local desktop view of Claude Code usage — plan limits, cost, and burn rate at a glance.",
  },
];

const stack = [
  { k: "Languages", v: "Python · C++ · JavaScript · R" },
  { k: "ML / AI", v: "PyTorch · Transformers · LLMs · RAG · Fine-tuning (QLoRA) · Instruction tuning" },
  { k: "Libraries", v: "HuggingFace · Unsloth · LangChain · scikit-learn · NumPy · Pandas" },
  { k: "Data", v: "SQL · PostgreSQL · FAISS · Chroma · JSONL pipelines" },
  { k: "Tools", v: "Git · Docker · Linux · Jupyter" },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manan Kapoor</title>
  <meta name="description" content={profile.lede} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <button id="theme-toggle" aria-label="Toggle theme">
    <span class="sun">☀</span><span class="moon">☾</span>
  </button>

  <div id="drogon" aria-hidden="true">
    <div class="bank"><div class="flip">
      <svg viewBox="0 0 240 170" xmlns="http://www.w3.org/2000/svg">
        <path class="wing wing-back" d="M112 74 C108 48 120 24 142 12 L138 28 L154 32 L143 42 L158 48 L138 52 L148 62 L122 60 Z"/>
        <path class="body" d="M216 80 C208 72 208 66 204 62 L208 56 L194 40 L200 57 L186 47 L196 59
          C180 62 166 67 146 74 C132 78 122 77 114 74 L106 67 L102 76 L92 68 L88 77
          C72 80 50 90 32 108 C22 117 15 119 8 114 L20 120 L6 124 L23 130
          C36 121 56 100 80 92 L96 96 L92 106 L104 100 C118 96 140 92 160 90
          L172 94 L168 104 L180 98 C192 94 202 90 208 86 L216 88 L208 82 Z"/>
        <path class="wing wing-front" d="M118 72 C116 44 130 18 156 8 L150 26 L168 30 L156 40 L172 46 L150 50 L160 62 L130 60 Z"/>
        <circle class="eye" cx="200" cy="64" r="2.3"/>
        <path class="fire" d="M216 80 L248 74 L231 80 L252 82 L229 86 L244 92 L216 87 Z"/>
      </svg>
    </div></div>
  </div>

  <main>
    <header class="hero">
      <h1>{profile.name}</h1>
      <p class="lede">{profile.lede}</p>
      <nav class="links">
        {profile.links.map((l) => (
          <a href={l.href} target={l.href.startsWith("/") ? null : "_blank"} rel="noopener">{l.label}</a>
        ))}
        <a href={`mailto:${profile.email}`}>Email</a>
      </nav>
    </header>

    <section>
      <span class="label">Work</span>
      {experience.map((e) => (
        <article class="entry">
          <div class="entry-head">
            <h3>{e.role} <span class="at">· {e.org}</span></h3>
            <span class="period">{e.period}</span>
          </div>
          <ul>{e.points.map((p) => <li set:html={p} />)}</ul>
        </article>
      ))}
      <article class="entry">
        <div class="entry-head">
          <h3>{education.degree} <span class="at">· {education.org}</span></h3>
          <span class="period">{education.period}</span>
        </div>
        <p class="note">{education.note}</p>
      </article>
    </section>

    <section>
      <span class="label">Selected work</span>
      <div class="grid">
        {projects.map((p) => (
          <a class="card" href={p.href} target="_blank" rel="noopener">
            <div class="card-top">
              <h3>{p.name}</h3>
              <span class="arrow">↗</span>
            </div>
            <p>{p.blurb}</p>
            <span class="tags">{p.tags}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <span class="label">Stack</span>
      <dl class="stack">
        {stack.map((s) => (
          <div class="stack-row"><dt>{s.k}</dt><dd>{s.v}</dd></div>
        ))}
      </dl>
    </section>

    <footer>
      <p>Open to 2026 AI/ML &amp; SWE internships and research.</p>
      <p class="muted">{profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </footer>
  </main>

  <script>
    // Theme
    const root = document.documentElement;
    const saved = localStorage.getItem("theme");
    if (saved) root.setAttribute("data-theme", saved);
    document.getElementById("theme-toggle")!.addEventListener("click", () => {
      const cur = root.getAttribute("data-theme")
        || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      const next = cur === "light" ? "dark" : "light";
      root.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    });

    // Drogon — snappy cursor pet: follows fast, patrols when idle, flies to clicks and breathes fire.
    const drogon = document.getElementById("drogon")!;
    const bank = drogon.firstElementChild as HTMLElement;
    const flip = bank.firstElementChild as HTMLElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let x = innerWidth * 0.5, y = innerHeight * 0.34;
    let tx = x, ty = y, px = x, py = y, patrol = true;
    const t0 = performance.now();

    addEventListener("mousemove", (e) => { patrol = false; tx = e.clientX + 46; ty = e.clientY - 60; });
    addEventListener("click", (e) => {
      patrol = false; tx = e.clientX + 46; ty = e.clientY - 60;
      drogon.classList.add("breathe");
      setTimeout(() => drogon.classList.remove("breathe"), 520);
    });

    function frame(t: number) {
      if (patrol) {
        const s = (t - t0) / 1000;
        tx = innerWidth * (0.5 + 0.34 * Math.sin(s * 0.5));
        ty = innerHeight * (0.30 + 0.10 * Math.sin(s * 1.1));
      }
      px = x; py = y;
      const k = reduce ? 1 : 0.16;
      x += (tx - x) * k;
      y += (ty - y) * k;
      const dx = x - px, dy = y - py;
      const facing = dx < -0.15 ? -1 : 1;            // art faces right
      const bankDeg = Math.max(-22, Math.min(22, dy * 1.6)) * facing;
      drogon.style.transform = `translate(${x}px, ${y}px)`;
      flip.style.transform = `scaleX(${facing})`;
      bank.style.transform = `rotate(${bankDeg}deg)`;
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  </script>

  <style>
    :root {
      --bg: #e9e5db;
      --ink: #1a1712;
      --muted: #6b6559;
      --line: rgba(26,23,18,0.13);
      --card: #f1eee6;
      --ember: #b4462f;
    }
    :root[data-theme="dark"] {
      --bg: #14110e; --ink: #e8e2d6; --muted: #8f887b;
      --line: rgba(232,226,214,0.14); --card: #1b1712; --ember: #d97a54;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #14110e; --ink: #e8e2d6; --muted: #8f887b;
        --line: rgba(232,226,214,0.14); --card: #1b1712; --ember: #d97a54;
      }
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Inter", system-ui, sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      transition: background .35s ease, color .35s ease;
    }
    a { color: inherit; }

    main { max-width: 760px; margin: 0 auto; padding: clamp(4rem, 14vh, 9rem) 28px 6rem; }

    /* Hero */
    .hero { margin-bottom: 5.5rem; }
    h1 {
      font-family: "Bricolage Grotesque", sans-serif;
      font-weight: 800;
      font-size: clamp(3rem, 11vw, 6.2rem);
      line-height: 0.92;
      letter-spacing: -0.04em;
      margin: 0 0 1.4rem;
    }
    .lede {
      font-size: clamp(1.1rem, 2.4vw, 1.4rem);
      line-height: 1.5;
      max-width: 30ch;
      color: var(--ink);
      margin: 0 0 2rem;
    }
    .links { display: flex; flex-wrap: wrap; gap: 1.6rem; font-size: 0.95rem; }
    .links a {
      text-decoration: none; color: var(--muted);
      padding-bottom: 2px; border-bottom: 1px solid transparent;
      transition: color .18s ease, border-color .18s ease;
    }
    .links a:hover { color: var(--ink); border-color: var(--ink); }

    /* Sections */
    section { padding-top: 2.6rem; border-top: 1px solid var(--line); margin-bottom: 3.5rem; }
    .label {
      display: block;
      font-family: "Bricolage Grotesque", sans-serif;
      font-weight: 600; font-size: 0.8rem;
      letter-spacing: 0.02em; color: var(--muted);
      margin-bottom: 1.8rem;
    }

    .entry { margin-bottom: 2rem; }
    .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
    .entry h3 {
      font-family: "Bricolage Grotesque", sans-serif;
      font-weight: 600; font-size: 1.15rem; margin: 0;
    }
    .entry .at { color: var(--muted); font-weight: 400; }
    .period { color: var(--muted); font-size: 0.9rem; white-space: nowrap; }
    .entry ul { margin: 0.9rem 0 0; padding-left: 1.1rem; }
    .entry li { margin-bottom: 0.55rem; color: var(--muted); }
    .entry li b { color: var(--ink); font-weight: 600; }
    .note { color: var(--muted); margin: 0.5rem 0 0; }

    /* Projects */
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .card {
      display: flex; flex-direction: column;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.35rem 1.4rem;
      text-decoration: none;
      transition: transform .18s ease, border-color .18s ease;
    }
    .card:hover { transform: translateY(-3px); border-color: var(--ember); }
    .card-top { display: flex; justify-content: space-between; align-items: center; }
    .card h3 {
      font-family: "Bricolage Grotesque", sans-serif;
      font-weight: 600; font-size: 1.05rem; margin: 0;
    }
    .arrow { color: var(--muted); transition: color .18s ease, transform .18s ease; }
    .card:hover .arrow { color: var(--ember); transform: translate(2px,-2px); }
    .card p { color: var(--muted); font-size: 0.92rem; margin: 0.6rem 0 1rem; flex: 1; }
    .card .tags { font-size: 0.78rem; color: var(--muted); letter-spacing: 0.01em; }

    /* Stack */
    .stack { margin: 0; }
    .stack-row { display: grid; grid-template-columns: 130px 1fr; gap: 1rem; padding: 0.7rem 0; border-top: 1px solid var(--line); }
    .stack-row:first-child { border-top: none; }
    .stack dt { font-weight: 500; color: var(--ink); font-size: 0.9rem; }
    .stack dd { margin: 0; color: var(--muted); font-size: 0.92rem; }

    footer { padding-top: 2.6rem; border-top: 1px solid var(--line); }
    footer p { margin: 0 0 0.3rem; }
    footer .muted { color: var(--muted); font-size: 0.9rem; }
    footer a { color: var(--muted); }
    footer a:hover { color: var(--ember); }

    /* Theme toggle */
    #theme-toggle {
      position: fixed; top: 18px; right: 20px; z-index: 50;
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--card); color: var(--ink);
      border: 1px solid var(--line); cursor: pointer;
      font-size: 1rem; line-height: 1;
      transition: transform .3s ease;
    }
    #theme-toggle:hover { transform: scale(1.08); }
    #theme-toggle .moon { display: none; }
    :root[data-theme="dark"] #theme-toggle .sun { display: none; }
    :root[data-theme="dark"] #theme-toggle .moon { display: inline; }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) #theme-toggle .sun { display: none; }
      :root:not([data-theme="light"]) #theme-toggle .moon { display: inline; }
    }

    /* Drogon */
    #drogon {
      position: fixed; top: 0; left: 0; z-index: 40;
      width: 104px; margin: -52px 0 0 -52px;
      pointer-events: none; will-change: transform;
    }
    #drogon .bank, #drogon .flip { will-change: transform; }
    #drogon svg { width: 100%; height: auto; display: block; filter: drop-shadow(0 8px 12px rgba(0,0,0,.3)); }
    #drogon .body, #drogon .spikes { fill: var(--ink); }
    #drogon .wing { fill: var(--ink); transform-box: fill-box; }
    #drogon .wing-front { transform-origin: 6% 92%; animation: flap .5s ease-in-out infinite; }
    #drogon .wing-back  { transform-origin: 6% 92%; opacity: .5; animation: flap .5s ease-in-out infinite; animation-delay: -.06s; }
    #drogon .eye { fill: var(--ember); }
    #drogon .fire { fill: var(--ember); opacity: 0; transform-box: fill-box; transform-origin: 0% 50%; transform: scaleX(.2); }
    #drogon.breathe .fire { animation: fire .5s ease-out; }

    @keyframes flap {
      0%, 100% { transform: rotate(4deg) scaleY(1); }
      50%      { transform: rotate(-14deg) scaleY(.62); }
    }
    @keyframes fire {
      0% { opacity: 0; transform: scaleX(.2); }
      35% { opacity: .95; transform: scaleX(1.15); }
      100% { opacity: 0; transform: scaleX(.4); }
    }
    @media (prefers-reduced-motion: reduce) {
      #drogon .wing { animation: none; }
      #theme-toggle, .card, .links a { transition: none; }
    }

    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
      .stack-row { grid-template-columns: 100px 1fr; }
      #drogon { width: 76px; margin: -38px 0 0 -38px; }
    }
  </style>
</body>
</html>
